    /**
     * Create a preauthorization.
     *
     * POST /api/v1/preauths
     */
    public function createPreauthorization(array $params): array
    {
        foreach ([
            'consent_token',
            'intervention_code',
            'service_start',
            'service_end',
        ] as $required) {
            if (
                !isset($params[$required]) ||
                $params[$required] === ''
            ) {
                throw new Exception(
                    "createPreauthorization: missing required param '{$required}'."
                );
            }
        }

        $token = $this->getAccessToken();

        $url = rtrim($this->baseUrl, '/') .
            '/api/v1/preauths';

        $items = $params['items'] ?? [];
        $diagnoses = $params['diagnoses'] ?? [];
        $doctors = $params['doctors'] ?? [];
        $attachments = $params['attachments'] ?? [];

        $attachmentMetadata = [];

        foreach ($attachments as $index => $attachment) {

            $filePath = $attachment['file_path'] ?? null;

            if ($filePath && !is_file($filePath)) {
                throw new Exception(
                    "createPreauthorization: attachment file not found: {$filePath}"
                );
            }

            $fileFieldName = $attachment['file_field_name']
                ?? "attachments_{$index}_file_blob";

            $attachmentMetadata[] = [
                'document_title'  =>
                    $attachment['document_title'] ?? null,
                'document_type'   =>
                    $attachment['document_type'] ?? null,
                'file_field_name' =>
                    $fileFieldName,
            ];
        }

        $multipart = [
            [
                'name'     => 'consent_token',
                'contents' => $params['consent_token'],
            ],
            [
                'name'     => 'intervention_code',
                'contents' => $params['intervention_code'],
            ],
            [
                'name'     => 'service_start',
                'contents' => $params['service_start'],
            ],
            [
                'name'     => 'service_end',
                'contents' => $params['service_end'],
            ],
            [
                'name'     => 'items',
                'contents' => json_encode($items),
            ],
            [
                'name'     => 'diagnoses',
                'contents' => json_encode($diagnoses),
            ],
            [
                'name'     => 'doctors',
                'contents' => json_encode($doctors),
            ],
            [
                'name'     => 'attachments',
                'contents' => json_encode($attachmentMetadata),
            ],
            [
                'name'     => 'provider_notification_email',
                'contents' =>
                    $params['provider_notification_email'] ?? '',
            ],
        ];

        foreach ($attachments as $index => $attachment) {

            $filePath = $attachment['file_path'] ?? null;

            if (!$filePath) {
                continue;
            }

            $fileFieldName = $attachment['file_field_name']
                ?? "attachments_{$index}_file_blob";

            $multipart[] = [
                'name'     => $fileFieldName,
                'contents' => fopen($filePath, 'r'),
                'filename' => basename($filePath),
            ];
        }

        $response = Http::withToken($token)
            ->acceptJson()
            ->asMultipart()
            ->timeout(30)
            ->post($url, $multipart);

        $this->logGatewayCall(
            'createPreauthorization',
            'POST',
            $url,
            $response,
            [
                'intervention_code' =>
                    $params['intervention_code'],
                'items_count' =>
                    count($items),
                'diagnoses_count' =>
                    count($diagnoses),
                'attachments_count' =>
                    count($attachments),
            ]
        );

        if ($response->failed()) {
            throw new Exception(
                "Create preauthorization failed ({$response->status()}): " .
                $response->body()
            );
        }

        $data = $response->json();

        return [
            'success' => true,
            'preauthorization_id' =>
                $data['id']
                ?? $data['guid']
                ?? $data['preauthorization_id']
                ?? null,
            'status' =>
                $data['status']
                ?? $data['workflow_state']
                ?? null,
            'raw' => $data,
        ];
    }

    /**
     * Get the current preauthorization status.
     *
     * GET /api/v1/preauths?consent_token=...
     */
    public function getPreauthorizationStatus(
        string $consentToken
    ): array {
        if (blank($consentToken)) {
            throw new Exception(
                'getPreauthorizationStatus: consent token is required.'
            );
        }

        $token = $this->getAccessToken();

        $url = rtrim($this->baseUrl, '/') .
            '/api/v1/preauths';

        $query = [
            'consent_token' => $consentToken,
        ];

        $response = Http::withToken($token)
            ->acceptJson()
            ->timeout(15)
            ->get($url, $query);

        $this->logGatewayCall(
            'getPreauthorizationStatus',
            'GET',
            $url,
            $response,
            [
                'query' => [
                    'consent_token' => '[REDACTED]',
                ],
            ]
        );

        if ($response->failed()) {
            throw new Exception(
                "Preauthorization status failed ({$response->status()}): " .
                $response->body()
            );
        }

        $data = $response->json();

        $preauthorization = $data;

        if (
            isset($data['results']) &&
            is_array($data['results'])
        ) {
            $preauthorization = $data['results'][0] ?? [];
        } elseif (
            isset($data['data']) &&
            is_array($data['data'])
        ) {
            $preauthorization = $data['data'];
        }

        return [
            'preauthorization_id' =>
                $preauthorization['id']
                ?? $preauthorization['guid']
                ?? $preauthorization['preauthorization_id']
                ?? null,

            'status' =>
                $preauthorization['status']
                ?? $preauthorization['workflow_state']
                ?? null,

            'raw' => $data,
        ];
    }

    /**
     * Poll until FINALISED or terminal failure.
     */
    public function waitForPreauthorization(
        string $consentToken,
        int $attempts = 12,
        int $seconds = 5
    ): array {
        if (blank($consentToken)) {
            throw new Exception(
                'waitForPreauthorization: consent token is required.'
            );
        }

        if ($attempts < 1) {
            throw new Exception(
                'waitForPreauthorization: attempts must be at least 1.'
            );
        }

        $result = null;

        for ($attempt = 1; $attempt <= $attempts; $attempt++) {

            $result = $this->getPreauthorizationStatus(
                $consentToken
            );

            $status = strtoupper(
                trim((string) ($result['status'] ?? ''))
            );

            if ($status === 'FINALISED') {
                return [
                    'success' => true,
                    'status'  => 'FINALISED',
                    'attempt' => $attempt,
                    'data'    => $result,
                ];
            }

            if (in_array($status, [
                'REJECTED',
                'DECLINED',
                'CANCELLED',
                'FAILED',
            ], true)) {
                return [
                    'success' => false,
                    'status'  => $status,
                    'attempt' => $attempt,
                    'data'    => $result,
                ];
            }

            if ($attempt < $attempts) {
                sleep($seconds);
            }
        }

        return [
            'success' => false,
            'status'  => 'TIMEOUT',
            'attempt' => $attempts,
            'data'    => $result,
        ];
    }

    /**
     * Preview the current virtual claim.
     *
     * POST /api/v1/claims/preview
     */
    public function previewClaim(string $consentToken): array
    {
        if (blank($consentToken)) {
            throw new Exception(
                'previewClaim: consent token is required.'
            );
        }

        $token = $this->getAccessToken();

        $url = rtrim($this->baseUrl, '/') .
            '/api/v1/claims/preview';

        $payload = [
            'consent_token' => $consentToken,
        ];

        $response = Http::withToken($token)
            ->acceptJson()
            ->timeout(20)
            ->post($url, $payload);

        $this->logGatewayCall(
            'previewClaim',
            'POST',
            $url,
            $response,
            [
                'payload_keys' => [
                    'consent_token',
                ],
            ]
        );

        if ($response->failed()) {
            throw new Exception(
                "Claim preview failed ({$response->status()}): " .
                $response->body()
            );
        }

        return [
            'success' => true,
            'raw'     => $response->json(),
        ];
    }

    /**
     * Final claim submission.
     *
     * POST /api/v1/claims/submit
     */
    public function submitClaim(
        string $consentToken,
        ?string $invoiceNumber = null,
        ?string $reasonForUnknownPatient = null
    ): array {
        if (blank($consentToken)) {
            throw new Exception(
                'submitClaim: consent token is required.'
            );
        }

        $token = $this->getAccessToken();

        $url = rtrim($this->baseUrl, '/') .
            '/api/v1/claims/submit';

        $payload = [
            'consent_token' => $consentToken,
        ];

        if ($invoiceNumber !== null) {
            $payload['invoice_number'] = $invoiceNumber;
        }

        if ($reasonForUnknownPatient !== null) {
            $payload['reason_for_unknown_patient'] =
                $reasonForUnknownPatient;
        }

        $response = Http::withToken($token)
            ->acceptJson()
            ->timeout(20)
            ->post($url, $payload);

        $this->logGatewayCall(
            'submitClaim',
            'POST',
            $url,
            $response,
            [
                'payload_keys' => array_keys($payload),
            ]
        );

        if ($response->failed()) {
            throw new Exception(
                "Submit claim failed ({$response->status()}): " .
                $response->body()
            );
        }

        return [
            'success' => true,
            'raw'     => $response->json(),
        ];
    }

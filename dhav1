    public function addClaimLine(array $params): array
    {
        foreach ([
            'consent_token',
            'intervention_code',
            'unit_price',
            'quantity',
            'service_name',
            'service_identifier',
            'practitioner_identification_number',
            'practitioner_regulation_body',
        ] as $required) {
            if (!isset($params[$required]) || $params[$required] === '') {
                throw new Exception(
                    "addClaimLine: missing required param '{$required}'."
                );
            }
        }

        $token = $this->getAccessToken();

        $url = rtrim($this->baseUrl, '/') .
            '/api/v1/claims/lines';

        $payload = [
            'consent_token'                       => $params['consent_token'],
            'intervention_code'                  => $params['intervention_code'],
            'unit_price'                          => (string) $params['unit_price'],
            'quantity'                            => (string) $params['quantity'],
            'service_name'                        => $params['service_name'],
            'service_identifier'                  => $params['service_identifier'],
            'practitioner_identification_type'   =>
                $params['practitioner_identification_type']
                ?? 'registration_number',
            'practitioner_identification_number' =>
                $params['practitioner_identification_number'],
            'practitioner_regulation_body'       =>
                $params['practitioner_regulation_body'],
        ];

        $response = Http::withToken($token)
            ->asForm()
            ->timeout(15)
            ->post($url, $payload);

        $this->logGatewayCall(
            'addClaimLine',
            'POST',
            $url,
            $response,
            [
                'intervention_code'  => $params['intervention_code'],
                'service_identifier' => $params['service_identifier'],
            ]
        );

        if ($response->failed()) {
            throw new Exception(
                "Add claim line failed ({$response->status()}): {$response->body()}"
            );
        }

        return [
            'success' => true,
            'raw'     => $response->json(),
        ];
    }


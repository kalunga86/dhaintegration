    public function syncPatientShaBenefits(string $patientId): array
    {
        return DB::transaction(function () use ($patientId) {

            $subBenefitsResponse = $this->getSubBenefits($patientId);

            $subBenefitsSynced = 0;
            $interventionsSynced = 0;

            foreach ($subBenefitsResponse['sub_benefits'] as $subBenefitData) {

                if (empty($subBenefitData['code'])) {
                    continue;
                }

                $subBenefit = ShaSubBenefit::updateOrCreate(
                    [
                        'code' => $subBenefitData['code'],
                    ],
                    [
                        'name'               => $subBenefitData['name'],
                        'access_point'       => $subBenefitData['access_point'],
                        'fund'                => $subBenefitData['fund'],
                        'parent_benefit'      => $subBenefitData['parent_benefit'],
                        'parent_benefit_code' => $subBenefitData['parent_benefit_code'],
                        'active'              => true,
                    ]
                );

                $subBenefitsSynced++;

                $interventionsResponse = $this->getInterventions(
                    $patientId,
                    $subBenefit->code
                );

                foreach ($interventionsResponse['interventions'] as $interventionData) {

                    if (empty($interventionData['code'])) {
                        continue;
                    }

                    ShaIntervention::updateOrCreate(
                        [
                            'code' => $interventionData['code'],
                        ],
                        [
                            'sha_sub_benefit_id' =>
                                $subBenefit->id,
                            'name' =>
                                $interventionData['name'],
                            'access_point' =>
                                $interventionData['access_point'],
                            'payment_mechanism' =>
                                $interventionData['payment_mechanism'],
                            'overall_tariff' =>
                                $interventionData['overall_tariff'],
                            'fund' =>
                                $interventionData['fund'],
                            'needs_preauth' =>
                                $interventionData['needs_preauth'],
                            'needs_manual_preauth_approval' =>
                                $interventionData['needs_manual_preauth_approval'],
                            'needs_doctor_authorization' =>
                                $interventionData['needs_doctor_authorization'],
                            'requires_surgical_preauth' =>
                                $interventionData['requires_surgical_preauth'],
                            'requires_renal_preauth' =>
                                $interventionData['requires_renal_preauth'],
                            'requires_oncology_preauth' =>
                                $interventionData['requires_oncology_preauth'],
                            'requires_radiology_preauth' =>
                                $interventionData['requires_radiology_preauth'],
                            'requires_optical_preauth' =>
                                $interventionData['requires_optical_preauth'],
                            'applicable_schemes' =>
                                $interventionData['applicable_schemes'],
                            'applicable_document_types' =>
                                $interventionData['applicable_document_types'],
                            'active' => true,
                            'last_synced_at' => now(),
                        ]
                    );

                    $interventionsSynced++;
                }
            }

            return [
                'patient_id'           => $patientId,
                'sub_benefits_synced'  => $subBenefitsSynced,
                'interventions_synced' => $interventionsSynced,
            ];
        });
    }

    public function searchPractitioner(
        string $identificationNumber,
        string $identificationType = 'registration_number',
        string $regulator = 'KMPDC'
    ): array {
        $token = $this->getAccessToken();

        $url = rtrim($this->baseUrl, '/') .
            '/api/v1/professionals';

        $query = [
            'identification_number' => $identificationNumber,
            'identification_type'   => $identificationType,
            'regulator'             => $regulator,
        ];

        $response = Http::withToken($token)
            ->acceptJson()
            ->timeout(15)
            ->get($url, $query);

        $this->logGatewayCall(
            'searchPractitioner',
            'GET',
            $url,
            $response,
            ['query' => $query]
        );

        if ($response->status() === 400) {
            $message = $response->json('message');

            if (
                is_string($message) &&
                str_contains(
                    strtolower($message),
                    'no practitioner membership returned'
                )
            ) {
                return [
                    'found'   => false,
                    'message' => $message,
                    'raw'     => $response->json(),
                ];
            }
        }

        if ($response->failed()) {
            throw new Exception(
                "Practitioner search failed ({$response->status()}): " .
                $response->body()
            );
        }

        return [
            'found' => true,
            'data'  => $response->json(),
        ];
    }


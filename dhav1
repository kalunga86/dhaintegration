    public function sendOtp(
        string $patientId,
        array $interventionCodes,
        ?int $beneficiaryContactId = null
    ): array {
        $token = $this->getAccessToken();

        $url = rtrim($this->baseUrl, '/') .
            '/api/v1/claims/otp';

        $payload = array_filter([
            'patient_id'             => $patientId,
            'intervention_codes'     => $interventionCodes,
            'beneficiary_contact_id' => $beneficiaryContactId,
        ], fn ($v) => $v !== null);

        $response = Http::withToken($token)
            ->timeout(15)
            ->post($url, $payload);

        $this->logGatewayCall(
            'sendOtp',
            'POST',
            $url,
            $response,
            ['payload' => $payload]
        );

        if ($response->failed()) {
            throw new Exception(
                "Send OTP failed ({$response->status()}): {$response->body()}"
            );
        }

        return [
            'success' => true,
            'raw'     => $response->json(),
        ];
    }

    public function createClaimVisit(array $params): array
    {
        foreach ([
            'patient_id',
            'intervention_codes',
            'service_type',
        ] as $required) {
            if (empty($params[$required])) {
                throw new Exception(
                    "createClaimVisit: missing required param '{$required}'."
                );
            }
        }

        if (empty($params['otp']) && empty($params['auth_guid'])) {
            throw new Exception(
                "createClaimVisit: either 'otp' or 'auth_guid' is required."
            );
        }

        $token = $this->getAccessToken();

        $url = rtrim($this->baseUrl, '/') .
            '/api/v1/claims/visit';

        $payload = array_filter([
            'patient_id'         => $params['patient_id'],
            'intervention_codes' => $params['intervention_codes'],
            'service_type'       => $params['service_type'],
            'otp'                => $params['otp'] ?? null,
            'auth_guid'          => $params['auth_guid'] ?? null,
        ], fn ($v) => $v !== null);

        $response = Http::withToken($token)
            ->timeout(20)
            ->post($url, $payload);

        $this->logGatewayCall(
            'createClaimVisit',
            'POST',
            $url,
            $response,
            [
                'payload_keys' => array_keys($payload),
            ]
        );

        if ($response->failed()) {
            throw new Exception(
                "Create claim visit failed ({$response->status()}): {$response->body()}"
            );
        }

        $data = $response->json();

        $consentToken = $data['authorization_code']
            ?? $data['consent_token']
            ?? $data['token']
            ?? null;

        if (!$consentToken) {
            Log::warning(
                'createClaimVisit: succeeded but no token found.',
                ['raw' => $data]
            );
        }

        return [
            'consent_token'  => $consentToken,
            'claim_id'       => $data['id'] ?? null,
            'workflow_state' => $data['workflow_state'] ?? null,
            'visit_number'   => $data['visit_number'] ?? null,
            'raw'            => $data,
        ];
    }


    protected string $baseUrl;
    protected string $clientId;
    protected string $clientSecret;

    public function __construct()
    {
        $this->baseUrl      = config('services.dha.base_url', env('DHA_BASE_URL'));
        $this->clientId     = config('services.dha.client_id', env('DHA_CLIENT_ID'));
        $this->clientSecret = config('services.dha.client_secret', env('DHA_CLIENT_SECRET'));
    }

    protected function logGatewayCall(
        string $label,
        string $method,
        string $url,
        $response,
        array $requestMeta = []
    ): void {
        $body = $response->json();

        if ($label === 'getAccessToken' && is_array($body)) {
            if (isset($body['access_token'])) {
                $body['access_token'] = '[REDACTED]';
            }
        }

        Log::info("DHA {$label}", array_merge([
            'method' => $method,
            'url'    => $url,
            'status' => $response->status(),
            'body'   => $body ?? $response->body(),
        ], $requestMeta));
    }

    protected function getAccessToken(): string
    {
        return Cache::remember('dha_middleware_token', 55, function () {

            if (empty($this->clientId) || empty($this->clientSecret)) {
                throw new Exception(
                    'Missing DHA_CLIENT_ID / DHA_CLIENT_SECRET in .env.'
                );
            }

            $url = rtrim($this->baseUrl, '/') .
                '/api/v1/tenants/token';

            $response = Http::asForm()
                ->timeout(15)
                ->post($url, [
                    'client_id'     => $this->clientId,
                    'client_secret' => $this->clientSecret,
                ]);

            $this->logGatewayCall(
                'getAccessToken',
                'POST',
                $url,
                $response
            );

            if ($response->failed()) {
                $error = $response->json('message')
                    ?? $response->json('error')
                    ?? $response->body();

                throw new Exception(
                    "DHA auth failed ({$response->status()}): {$error}"
                );
            }

            $token = $response->json('access_token');

            if (blank($token)) {
                throw new Exception(
                    'DHA returned no access_token: ' . $response->body()
                );
            }

            return $token;
        });
    }

    public function searchPatient(
        string $identificationNumber,
        string $identificationType = 'National ID'
    ): array {
        $token = $this->getAccessToken();

        $url = rtrim($this->baseUrl, '/') .
            '/api/v1/patients';

        $query = [
            'identification_number' => $identificationNumber,
            'identification_type'   => $identificationType,
        ];

        $response = Http::withToken($token)
            ->timeout(15)
            ->get($url, $query);

        $this->logGatewayCall(
            'searchPatient',
            'GET',
            $url,
            $response,
            ['query' => $query]
        );

        if ($response->status() === 400) {
            $msg = $response->json('message') ?? '';

            if (str_contains($msg, 'zero results found')) {
                return [
                    'found' => false,
                    'raw'   => $response->json(),
                ];
            }
        }

        if ($response->failed()) {
            throw new Exception(
                "Patient search failed ({$response->status()}): {$response->body()}"
            );
        }

        $data = $response->json();

        $otherIds = collect($data['other_identifications'] ?? []);

        $shaNumber = $otherIds->firstWhere(
            'identification_type',
            'SHA Number'
        )['identification_number'] ?? null;

        $householdNumber = $otherIds->firstWhere(
            'identification_type',
            'Household Number'
        )['identification_number'] ?? null;

        return [
            'found'            => true,
            'patient_id'       => $data['id'] ?? null,
            'full_name'        => trim(
                ($data['first_name'] ?? '') . ' ' .
                ($data['middle_name'] ?? '') . ' ' .
                ($data['last_name'] ?? '')
            ),
            'first_name'       => $data['first_name'] ?? null,
            'last_name'        => $data['last_name'] ?? null,
            'gender'           => $data['gender'] ?? null,
            'date_of_birth'    => $data['date_of_birth'] ?? null,
            'phone'            => $data['phone'] ?? null,
            'county'           => $data['county'] ?? null,
            'sub_county'       => $data['sub_county'] ?? null,
            'sha_number'       => $shaNumber,
            'household_number' => $householdNumber,
            'employment_type'  => $data['employment_type'] ?? null,
            'raw'              => $data,
        ];
    }

    public function checkEligibility(
        string $identificationNumber,
        string $identificationType = 'National ID'
    ): array {
        $token = $this->getAccessToken();

        $url = rtrim($this->baseUrl, '/') .
            '/api/v1/patients/eligibility';

        $query = [
            'identification_number' => $identificationNumber,
            'identification_type'   => $identificationType,
        ];

        $response = Http::withToken($token)
            ->timeout(15)
            ->get($url, $query);

        $this->logGatewayCall(
            'checkEligibility',
            'GET',
            $url,
            $response,
            ['query' => $query]
        );

        if ($response->failed()) {
            throw new Exception(
                "Eligibility check failed ({$response->status()}): {$response->body()}"
            );
        }

        $data = $response->json();

        $schemes = collect($data['schemes'] ?? [])
            ->map(function ($s) {
                return [
                    'scheme_name'      => $s['schemeName'] ?? null,
                    'member_type'      => $s['memberType'] ?? null,
                    'policy_start'     => $s['policy']['startDate'] ?? null,
                    'policy_end'       => $s['policy']['endDate'] ?? null,
                    'policy_number'    => $s['policy']['number'] ?? null,
                    'covered'          => ($s['coverage']['status'] ?? null) === '1',
                    'coverage_message' => $s['coverage']['message'] ?? null,
                    'coverage_reason'  => $s['coverage']['reason'] ?? null,
                    'coverage_start'   => $s['coverage']['startDate'] ?? null,
                    'coverage_end'     => $s['coverage']['endDate'] ?? null,
                ];
            })
            ->values();

        return [
            'found'            => ($data['statusCode'] ?? null) === '10',
            'status_code'      => $data['statusCode'] ?? null,
            'status_desc'      => $data['statusDesc'] ?? null,
            'full_name'        => $data['fullName'] ?? null,
            'member_cr_number' => $data['memberCrNumber'] ?? null,
            'is_alive'         => $data['isAlive'] ?? null,
            'eligible'         => $schemes->contains('covered', true),
            'schemes'          => $schemes,
            'raw'              => $data,
        ];
    }

    public function patientLookup(
        string $identificationNumber,
        string $identificationType = 'National ID'
    ): array {
        $patient = $this->searchPatient(
            $identificationNumber,
            $identificationType
        );

        if (!$patient['found']) {
            return [
                'sha_status'  => 'not_registered',
                'patient'     => null,
                'eligibility' => null,
            ];
        }

        $eligibility = $this->checkEligibility(
            $identificationNumber,
            $identificationType
        );

        return [
            'sha_status'  => $eligibility['eligible']
                ? 'eligible'
                : 'not_eligible',
            'patient'     => $patient,
            'eligibility' => $eligibility,
        ];
    }

